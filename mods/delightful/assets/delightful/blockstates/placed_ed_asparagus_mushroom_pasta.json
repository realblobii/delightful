{
  "multipart": [
    {
      "apply": {
        "model": "delightful:block/dd/wood_support"
      },
      "when": {
        "support": "true"
      }
    },
    {
      "apply": {
        "model": "delightful:block/dd/ed_asparagus_mushroom_pasta"
      },
      "when": {
        "AND": [
          {
            "facing": "north"
          }
        ]
      }
    },
    {
      "apply": {
        "model": "delightful:block/dd/ed_asparagus_mushroom_pasta",
        "y": 180
      },
      "when": {
        "AND": [
          {
            "facing": "south"
          }
        ]
      }
    },
    {
      "apply": {
        "model": "delightful:block/dd/ed_asparagus_mushroom_pasta",
        "y": 270
      },
      "when": {
        "AND": [
          {
            "facing": "west"
          }
        ]
      }
    },
    {
      "apply": {
        "model": "delightful:block/dd/ed_asparagus_mushroom_pasta",
        "y": 90
      },
      "when": {
        "AND": [
          {
            "facing": "east"
          }
        ]
      }
    }
  ]
}
